PORT=5001
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ai-code-review?retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key-change-in-production
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
AI_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
GITHUB_TOKEN=
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
FREE_DAILY_LIMIT=20

# Redis / BullMQ (optional — memory fallback if unset)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Judge0 sandbox (optional — simulator without key)
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# GitHub App / PR review bot
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
SYSTEM_USER_ID=
